const mockUsers = [
  {name:'Айгерим К.',grade:'10 класс',courses:4,country:'Алматы 🇰🇿',av:'АК',color:'#6C63FF'},
  {name:'Данияр М.',grade:'11 класс',courses:6,country:'Астана 🇰🇿',av:'ДМ',color:'#38BDF8'},
  {name:'Лейла Н.',grade:'9 класс',courses:2,country:'Шымкент 🇰🇿',av:'ЛН',color:'#34D399'},
  {name:'Артём В.',grade:'10 класс',courses:3,country:'Алматы 🇰🇿',av:'АВ',color:'#FB923C'},
  {name:'Зарина Ж.',grade:'11 класс',courses:5,country:'Павлодар 🇰🇿',av:'ЗЖ',color:'#A78BFA'},
  {name:'Камила О.',grade:'8 класс',courses:2,country:'Астана 🇰🇿',av:'КО',color:'#F87171'},
];

// ============ STATE ============
let state = {
  page: 'home',
  user: null,
  savedOpps: [],
  enrolledCourses: [1,2,3],
  lessonProgress: {},
  currentCourse: null,
  onboardStep: 1,
  selectedInterests: [],
};

// ============ NAVIGATION ============
function showPage(name) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const el = document.getElementById('page-' + name);
  if(el) { el.classList.add('active'); state.page = name; }
  if(name==='opportunities') renderOpps();
  if(name==='courses') renderCourses();
  if(name==='dashboard') renderDashboard();
  if(name==='admin') renderAdmin();
  window.scrollTo(0,0);
}

function setActive(btn) {
  document.querySelectorAll('.nav-link').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
}
function setActiveByName(name) {
  document.querySelectorAll('.nav-link').forEach(b => {
    if(b.textContent.trim()===name) b.classList.add('active');
    else b.classList.remove('active');
  });
}

// ============ ONBOARDING ============
function showOnboarding() {
  state.onboardStep = 1;
  updateStepDots(3);
  document.querySelectorAll('.modal-step').forEach(s => s.classList.remove('active'));
  document.getElementById('step1').classList.add('active');
  document.getElementById('onboardModal').style.display = 'flex';
}

function updateStepDots(total) {
  const c = document.getElementById('stepDots');
  c.innerHTML = '';
  for(let i=1;i<=total;i++){
    const d = document.createElement('div');
    d.className = 'step-dot' + (i===state.onboardStep?' active':'');
    c.appendChild(d);
  }
}

function nextStep(n) {
  state.onboardStep = n;
  updateStepDots(3);
  document.querySelectorAll('.modal-step').forEach(s => s.classList.remove('active'));
  document.getElementById('step'+n).classList.add('active');
}

function toggleInterest(btn) { btn.classList.toggle('selected'); }

function finishOnboarding() {
  const name = document.getElementById('ob-name').value || 'Ученик';
  const grade = document.getElementById('ob-grade').value || '10 класс';
  state.user = {name, grade};
  document.getElementById('onboardModal').style.display = 'none';
  const navRight = document.getElementById('navRight');
  navRight.innerHTML = `<div class="avatar" onclick="showPage('dashboard');setActiveByName('Кабинет')">${name.charAt(0).toUpperCase()}</div>`;
  showToast(`Добро пожаловать, ${name}! 🎉`);
  document.getElementById('dash-greeting').textContent = `Привет, ${name}! 👋`;
}

// ============ OPPORTUNITIES ============
function renderOpps(data) {
  const grid = document.getElementById('oppsGrid');
  const list = data || opportunities;
  grid.innerHTML = list.map(o => `
    <div class="opp-card" id="opp-card-${o.id}">
      <div class="card-top">
        <span class="category-badge ${catClass(o.cat)}">${o.cat}</span>
        <button class="save-btn ${o.saved?'saved':''}" onclick="toggleSave(${o.id})" title="Сохранить">${o.saved?'⭐':'☆'}</button>
      </div>
      <h3>${o.title}</h3>
      <p>${o.desc}</p>
      <div class="opp-meta">
        <span>📅 <span class="deadline">${formatDate(o.deadline)}</span></span>
        <span>🌐 ${o.fmt}</span>
        <span>🎓 ${o.grade} кл.</span>
      </div>
      <div class="card-footer">
        <button class="btn-card btn-apply" onclick="showToast('Переход на страницу подачи заявки...')">Подать заявку</button>
        <button class="btn-card btn-more" onclick="showToast('Подробнее о программе...')">Подробнее</button>
      </div>
    </div>
  `).join('') || '<div class="empty-state"><div class="empty-icon">🔍</div><h3>Ничего не найдено</h3><p>Попробуй изменить фильтры</p></div>';
}

function catClass(cat) {
  return {STEM:'cat-stem',Бизнес:'cat-biz',Наука:'cat-sci',Социальное:'cat-social',Финансы:'cat-fin'}[cat]||'cat-stem';
}

function filterOpps() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const cat = document.getElementById('catFilter').value;
  const fmt = document.getElementById('fmtFilter').value;
  const gr = document.getElementById('gradeFilter').value;
  const filtered = opportunities.filter(o =>
    (!q || o.title.toLowerCase().includes(q) || o.desc.toLowerCase().includes(q)) &&
    (!cat || o.cat===cat) &&
    (!fmt || o.fmt===fmt) &&
    (!gr || o.grade.includes(gr))
  );
  renderOpps(filtered);
}

function toggleSave(id) {
  const o = opportunities.find(x => x.id===id);
  if(!o) return;
  o.saved = !o.saved;
  state.savedOpps = opportunities.filter(x => x.saved);
  document.getElementById('savedCount').textContent = state.savedOpps.length;
  const btn = document.querySelector(`#opp-card-${id} .save-btn`);
  if(btn){ btn.textContent = o.saved?'⭐':'☆'; btn.classList.toggle('saved',o.saved); }
  showToast(o.saved ? '⭐ Добавлено в сохранённые!' : 'Удалено из сохранённых');
}

function formatDate(d) {
  const dt = new Date(d);
  return dt.toLocaleDateString('ru-RU',{day:'numeric',month:'short'});
}

function daysLeft(d) {
  return Math.ceil((new Date(d)-new Date())/(1000*60*60*24));
}

// ============ COURSES ============
function renderCourses(data) {
  const grid = document.getElementById('coursesGrid');
  const list = data || courses;
  grid.innerHTML = list.map(c => `
    <div class="course-card" onclick="openCourse(${c.id})">
      <div class="course-banner" style="background:linear-gradient(135deg,${c.color}22,${c.color}44)">${c.emoji}</div>
      <div class="course-body">
        <div class="course-meta-row">
          <span class="level-badge ${levelClass(c.level)}">${c.level}</span>
          <span class="lessons-count">${c.lessons.length} уроков</span>
        </div>
        <h3>${c.title}</h3>
        <p>${c.desc}</p>
        ${c.enrolled ? `
          <div class="progress-bar-wrap">
            <div class="progress-bar-label"><span>Прогресс</span><span>${c.progress}%</span></div>
            <div class="progress-bar"><div class="progress-fill" style="width:${c.progress}%"></div></div>
          </div>
        ` : ''}
        <button class="btn-course" onclick="event.stopPropagation();openCourse(${c.id})">${c.enrolled ? 'Продолжить' : 'Начать курс'}</button>
      </div>
    </div>
  `).join('');
}

function levelClass(l) {
  return {Начинающий:'level-beginner',Средний:'level-inter',Продвинутый:'level-adv'}[l]||'level-beginner';
}

function filterCourses() {
  const cat = document.getElementById('courseCatFilter').value;
  const level = document.getElementById('levelFilter').value;
  const filtered = courses.filter(c => (!cat || c.subj===cat) && (!level || c.level===level));
  renderCourses(filtered);
}

function openCourse(id) {
  const c = courses.find(x => x.id===id);
  if(!c) return;
  state.currentCourse = c;
  if(!c.enrolled){ c.enrolled=true; c.progress=0; state.enrolledCourses.push(id); }

  document.getElementById('cd-title').textContent = c.emoji + ' ' + c.title;
  document.getElementById('cd-desc').textContent = c.desc;
  document.getElementById('cd-pills').innerHTML = `
    <span class="info-pill">${c.subj}</span>
    <span class="info-pill">${c.level}</span>
    <span class="info-pill">${c.lessons.length} уроков</span>
    <span class="info-pill">~${c.lessons.length*20} мин.</span>
  `;

  const prog = state.lessonProgress[id] || {};
  const completed = Object.keys(prog).length;
  const pct = Math.round((completed/c.lessons.length)*100);

  document.getElementById('cd-lessons').innerHTML = c.lessons.map((l,i) => `
    <div class="lesson-item ${prog[i]?'completed':''}" onclick="selectLesson(${i})">
      <div class="lesson-num">${prog[i]?'✓':(i+1)}</div>
      <div class="lesson-info"><h4>${l}</h4><span>${prog[i]?'Пройдено':'~20 мин.'}</span></div>
    </div>
  `).join('');

  document.getElementById('cd-prog-label').textContent = pct + '%';
  document.getElementById('cd-prog-bar').style.width = pct + '%';

  // Quiz
  const q = c.quiz;
  document.getElementById('cd-quiz').innerHTML = `
    <p style="font-size:14px;margin-bottom:12px;color:var(--text2)">${q.q}</p>
    ${q.opts.map((o,i)=>`<div class="quiz-option" id="quiz-opt-${i}" onclick="checkQuiz(${i},${q.ans})">${o}</div>`).join('')}
  `;

  showPage('courseDetail');
}

function selectLesson(i) {
  showToast(`📖 Урок ${i+1} открыт. Смотри видео и изучай материал!`);
}

function markComplete() {
  const c = state.currentCourse;
  if(!c) return;
  if(!state.lessonProgress[c.id]) state.lessonProgress[c.id] = {};
  const prog = state.lessonProgress[c.id];
  const next = Object.keys(prog).length;
  if(next >= c.lessons.length){ showToast('🎉 Курс полностью пройден!'); return; }
  prog[next] = true;
  c.progress = Math.round((Object.keys(prog).length / c.lessons.length) * 100);
  openCourse(c.id);
  showToast(`✅ Урок "${c.lessons[next]}" пройден!`);
}

function checkQuiz(chosen, correct) {
  document.querySelectorAll('.quiz-option').forEach((el,i) => {
    el.classList.remove('correct','wrong');
    if(i===correct) el.classList.add('correct');
    else if(i===chosen && chosen!==correct) el.classList.add('wrong');
  });
  showToast(chosen===correct ? '🎉 Правильно!' : '❌ Попробуй снова!');
}

// ============ DASHBOARD ============
function renderDashboard() {
  document.getElementById('savedCount').textContent = state.savedOpps.length;

  // enrolled courses
  const enrolled = courses.filter(c => c.enrolled);
  document.getElementById('dash-courses').innerHTML = enrolled.slice(0,3).map(c => `
    <div class="course-card" onclick="openCourse(${c.id})">
      <div class="course-banner" style="background:linear-gradient(135deg,${c.color}22,${c.color}44)">${c.emoji}</div>
      <div class="course-body">
        <h3>${c.title}</h3>
        <div class="progress-bar-wrap">
          <div class="progress-bar-label"><span>Прогресс</span><span>${c.progress}%</span></div>
          <div class="progress-bar"><div class="progress-fill" style="width:${c.progress}%"></div></div>
        </div>
        <button class="btn-course">Продолжить</button>
      </div>
    </div>
  `).join('');

  // deadlines
  const sorted = [...opportunities].sort((a,b) => new Date(a.deadline)-new Date(b.deadline));
  document.getElementById('dash-deadlines').innerHTML = sorted.slice(0,5).map(o => {
    const d = daysLeft(o.deadline);
    const cls = d<=7?'days-urgent':d<=30?'days-soon':'days-ok';
    return `
      <div class="deadline-item">
        <div class="deadline-info"><h4>${o.title}</h4><span>${o.cat} · ${o.fmt}</span></div>
        <div class="deadline-days ${cls}">${d > 0 ? d + ' дн.' : 'Сегодня!'}</div>
      </div>
    `;
  }).join('');

  // saved
  const saved = state.savedOpps;
  const savedEl = document.getElementById('dash-saved');
  if(saved.length === 0) {
    savedEl.innerHTML = `<div class="empty-state"><div class="empty-icon">📌</div><h3>Пусто</h3><p>Сохраняй интересные возможности — они появятся здесь</p></div>`;
  } else {
    savedEl.innerHTML = saved.map(o => `
      <div class="opp-card">
        <div class="card-top">
          <span class="category-badge ${catClass(o.cat)}">${o.cat}</span>
          <button class="save-btn saved" onclick="toggleSave(${o.id})">⭐</button>
        </div>
        <h3>${o.title}</h3>
        <p>${o.desc}</p>
        <div class="opp-meta"><span>📅 <span class="deadline">${formatDate(o.deadline)}</span></span></div>
        <div class="card-footer">
          <button class="btn-card btn-apply" onclick="showToast('Переход к заявке...')">Подать заявку</button>
        </div>
      </div>
    `).join('');
  }
}

// ============ ADMIN ============
function renderAdmin() {
  renderAdminOppTable();
  renderAdminCourseTable();
  renderUsersGrid();
}

function renderAdminOppTable() {
  document.getElementById('adm-opp-table').innerHTML = opportunities.map(o => `
    <tr>
      <td>${o.title}</td>
      <td><span class="category-badge ${catClass(o.cat)}">${o.cat}</span></td>
      <td>${formatDate(o.deadline)}</td>
      <td>${o.fmt}</td>
      <td>
        <button class="tag-edit" onclick="showToast('Редактирование...')">Изм.</button>
        <button class="tag-del" onclick="showToast('Удалено!')">Удал.</button>
      </td>
    </tr>
  `).join('');
}

function renderAdminCourseTable() {
  document.getElementById('adm-c-table').innerHTML = courses.map(c => `
    <tr>
      <td>${c.emoji} ${c.title}</td>
      <td>${c.subj}</td>
      <td><span class="level-badge ${levelClass(c.level)}">${c.level}</span></td>
      <td>${c.lessons.length}</td>
      <td>
        <button class="tag-edit" onclick="showToast('Редактирование...')">Изм.</button>
        <button class="tag-del" onclick="showToast('Удалено!')">Удал.</button>
      </td>
    </tr>
  `).join('');
}

function renderUsersGrid() {
  document.getElementById('users-grid').innerHTML = mockUsers.map(u => `
    <div class="user-card">
      <div class="user-card-top">
        <div class="user-av" style="background:${u.color}33;color:${u.color}">${u.av}</div>
        <div><h4>${u.name}</h4><span>${u.grade}</span></div>
      </div>
      <div style="font-size:12px;color:var(--text3);margin-bottom:6px">${u.country}</div>
      <div class="user-stat"><span>Курсов</span><span style="color:var(--text)">${u.courses}</span></div>
      <div class="user-stat"><span>Статус</span><span style="color:var(--green)">Активен</span></div>
    </div>
  `).join('');
}

function adminAddOpp() {
  const name = document.getElementById('adm-opp-name').value;
  const cat = document.getElementById('adm-opp-cat').value;
  const deadline = document.getElementById('adm-opp-deadline').value;
  const fmt = document.getElementById('adm-opp-fmt').value;
  const desc = document.getElementById('adm-opp-desc').value;
  if(!name) { showToast('❗ Введите название'); return; }
  opportunities.push({id:Date.now(),title:name,cat,fmt,grade:'8-11',deadline:deadline||'2026-12-31',desc:desc||'',saved:false});
  document.getElementById('adm-opp-name').value='';
  document.getElementById('adm-opp-desc').value='';
  renderAdminOppTable();
  showToast('✅ Возможность добавлена!');
}

function adminAddCourse() {
  const name = document.getElementById('adm-c-name').value;
  const cat = document.getElementById('adm-c-cat').value;
  const level = document.getElementById('adm-c-level').value;
  const n = parseInt(document.getElementById('adm-c-lessons').value)||5;
  const desc = document.getElementById('adm-c-desc').value;
  if(!name) { showToast('❗ Введите название'); return; }
  const emojis = {Математика:'🔢',Английский:'🇬🇧',Физика:'⚛️',Биология:'🧬',Информатика:'💻',Экономика:'📈',Поступление:'🎓'};
  courses.push({id:Date.now(),title:name,subj:cat,level,emoji:emojis[cat]||'📚',color:'#6C63FF',lessons:Array.from({length:n},(_,i)=>`Урок ${i+1}`),desc:desc||'',progress:0,enrolled:false,quiz:{q:'Тестовый вопрос?',opts:['А','Б','В','Г'],ans:0}});
  document.getElementById('adm-c-name').value='';
  document.getElementById('adm-c-desc').value='';
  document.getElementById('adm-c-lessons').value='';
  renderAdminCourseTable();
  showToast('✅ Курс добавлен!');
}

function switchAdminTab(name, btn) {
  document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.admin-panel').forEach(p => p.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('admin-'+name).classList.add('active');
}

// ============ TOAST ============
let toastTimer;
function showToast(msg) {
  const t = document.getElementById('toast');
  document.getElementById('toastMsg').textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 2800);
}

// ============ INIT ============
renderOpps();
renderCourses();
</script>

<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mentoria Hub — Образовательная платформа</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Manrope:wght@400;600;700;800&display=swap');

  :root {
    --bg: #0D0F1A;
    --surface: #151829;
    --surface2: #1C2035;
    --border: #252A42;
    --accent: #6C63FF;
    --accent2: #A78BFA;
    --accent3: #38BDF8;
    --green: #34D399;
    --orange: #FB923C;
    --text: #E8EAFF;
    --text2: #8892B0;
    --text3: #5A6480;
    --radius: 14px;
    --radius-sm: 8px;
  }

  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family:'Inter',sans-serif; background:var(--bg); color:var(--text); min-height:100vh; }

  /* NAV */
  nav {
    position:fixed; top:0; left:0; right:0; z-index:100;
    background:rgba(13,15,26,0.85); backdrop-filter:blur(16px);
    border-bottom:1px solid var(--border);
    display:flex; align-items:center; justify-content:space-between;
    padding:0 32px; height:64px;
  }
  .logo { font-family:'Manrope',sans-serif; font-weight:800; font-size:20px; color:var(--text); display:flex; align-items:center; gap:10px; cursor:pointer; }
  .logo-icon { width:32px; height:32px; background:linear-gradient(135deg,var(--accent),var(--accent3)); border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:16px; }
  .nav-links { display:flex; gap:4px; }
  .nav-link { padding:8px 16px; border-radius:var(--radius-sm); color:var(--text2); font-size:14px; font-weight:500; cursor:pointer; transition:all .2s; border:none; background:none; }
  .nav-link:hover, .nav-link.active { color:var(--text); background:var(--surface2); }
  .nav-right { display:flex; gap:10px; align-items:center; }
  .btn { padding:9px 20px; border-radius:var(--radius-sm); font-size:14px; font-weight:600; cursor:pointer; border:none; transition:all .2s; }
  .btn-ghost { background:transparent; color:var(--text2); border:1px solid var(--border); }
  .btn-ghost:hover { border-color:var(--accent); color:var(--accent); }
  .btn-primary { background:linear-gradient(135deg,var(--accent),#8B5CF6); color:#fff; }
  .btn-primary:hover { opacity:.9; transform:translateY(-1px); }
  .btn-sm { padding:7px 14px; font-size:13px; }
  .avatar { width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,var(--accent),var(--accent3)); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px; cursor:pointer; }

  /* PAGES */
  .page { display:none; padding-top:64px; min-height:100vh; }
  .page.active { display:block; }

  /* HOME */
  .hero {
    min-height:calc(100vh - 64px);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; padding:60px 24px;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(108,99,255,.15) 0%, transparent 70%);
    position:relative;
  }
  .hero-badge { display:inline-flex; align-items:center; gap:8px; background:rgba(108,99,255,.12); border:1px solid rgba(108,99,255,.3); border-radius:100px; padding:6px 16px; font-size:13px; color:var(--accent2); margin-bottom:28px; }
  .hero h1 { font-family:'Manrope',sans-serif; font-size:clamp(36px,6vw,72px); font-weight:800; line-height:1.1; margin-bottom:24px; }
  .hero h1 span { background:linear-gradient(135deg,var(--accent),var(--accent3)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .hero p { font-size:clamp(16px,2vw,20px); color:var(--text2); max-width:600px; line-height:1.6; margin-bottom:40px; }
  .hero-cta { display:flex; gap:14px; flex-wrap:wrap; justify-content:center; }
  .btn-large { padding:14px 32px; font-size:16px; border-radius:12px; }

  .stats-row { display:flex; gap:48px; margin-top:72px; justify-content:center; flex-wrap:wrap; }
  .stat { text-align:center; }
  .stat-num { font-family:'Manrope',sans-serif; font-size:32px; font-weight:800; background:linear-gradient(135deg,var(--accent),var(--accent3)); -webkit-background-clip:text; -webkit-text-fill-color:transparent; }
  .stat-label { font-size:13px; color:var(--text3); margin-top:4px; }

  .features-section { padding:80px 32px; max-width:1100px; margin:0 auto; }
  .section-title { font-family:'Manrope',sans-serif; font-size:clamp(24px,3vw,36px); font-weight:800; text-align:center; margin-bottom:12px; }
  .section-sub { color:var(--text2); text-align:center; margin-bottom:48px; font-size:16px; }
  .features-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:20px; }
  .feature-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:28px; transition:all .3s; }
  .feature-card:hover { border-color:var(--accent); transform:translateY(-4px); }
  .feature-icon { width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:22px; margin-bottom:16px; }
  .feature-card h3 { font-size:17px; font-weight:700; margin-bottom:8px; }
  .feature-card p { font-size:14px; color:var(--text2); line-height:1.6; }

  /* OPPORTUNITIES */
  .page-header { padding:40px 32px 0; max-width:1100px; margin:0 auto; }
  .page-header h2 { font-family:'Manrope',sans-serif; font-size:28px; font-weight:800; margin-bottom:6px; }
  .page-header p { color:var(--text2); font-size:15px; }
  .content-area { max-width:1100px; margin:0 auto; padding:24px 32px 60px; }

  .filter-bar { display:flex; gap:10px; flex-wrap:wrap; margin-bottom:28px; align-items:center; }
  .filter-select { background:var(--surface); border:1px solid var(--border); color:var(--text); padding:9px 14px; border-radius:var(--radius-sm); font-size:13px; cursor:pointer; outline:none; font-family:'Inter',sans-serif; }
  .filter-select:focus { border-color:var(--accent); }
  .search-input { background:var(--surface); border:1px solid var(--border); color:var(--text); padding:9px 16px; border-radius:var(--radius-sm); font-size:13px; outline:none; font-family:'Inter',sans-serif; width:240px; }
  .search-input::placeholder { color:var(--text3); }
  .search-input:focus { border-color:var(--accent); }

  .cards-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:18px; }
  .opp-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:22px; transition:all .2s; position:relative; }
  .opp-card:hover { border-color:rgba(108,99,255,.5); box-shadow:0 8px 32px rgba(108,99,255,.1); }
  .card-top { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12px; }
  .category-badge { font-size:11px; font-weight:600; padding:4px 10px; border-radius:100px; }
  .cat-stem { background:rgba(56,189,248,.15); color:var(--accent3); }
  .cat-biz { background:rgba(251,146,60,.15); color:var(--orange); }
  .cat-sci { background:rgba(52,211,153,.15); color:var(--green); }
  .cat-social { background:rgba(167,139,250,.15); color:var(--accent2); }
  .cat-fin { background:rgba(251,191,36,.15); color:#FCD34D; }
  .save-btn { background:none; border:none; color:var(--text3); font-size:18px; cursor:pointer; transition:color .2s; padding:2px; }
  .save-btn:hover, .save-btn.saved { color:#FCD34D; }
  .opp-card h3 { font-size:16px; font-weight:700; margin-bottom:8px; line-height:1.4; }
  .opp-card p { font-size:13px; color:var(--text2); line-height:1.5; margin-bottom:14px; }
  .opp-meta { display:flex; gap:12px; font-size:12px; color:var(--text3); margin-bottom:16px; flex-wrap:wrap; }
  .opp-meta span { display:flex; align-items:center; gap:4px; }
  .deadline { color:var(--orange); font-weight:600; }
  .card-footer { display:flex; gap:8px; }
  .btn-card { flex:1; padding:9px; border-radius:var(--radius-sm); font-size:13px; font-weight:600; cursor:pointer; border:none; }
  .btn-apply { background:linear-gradient(135deg,var(--accent),#8B5CF6); color:#fff; }
  .btn-apply:hover { opacity:.9; }
  .btn-more { background:var(--surface2); color:var(--text2); border:1px solid var(--border); }
  .btn-more:hover { color:var(--text); border-color:var(--accent); }

  /* COURSES */
  .courses-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:18px; }
  .course-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); overflow:hidden; transition:all .2s; cursor:pointer; }
  .course-card:hover { border-color:rgba(108,99,255,.5); transform:translateY(-3px); }
  .course-banner { height:130px; display:flex; align-items:center; justify-content:center; font-size:48px; }
  .course-body { padding:20px; }
  .course-meta-row { display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; }
  .level-badge { font-size:11px; font-weight:600; padding:3px 10px; border-radius:100px; }
  .level-beginner { background:rgba(52,211,153,.15); color:var(--green); }
  .level-inter { background:rgba(251,146,60,.15); color:var(--orange); }
  .level-adv { background:rgba(248,113,113,.15); color:#F87171; }
  .lessons-count { font-size:12px; color:var(--text3); }
  .course-card h3 { font-size:16px; font-weight:700; margin-bottom:8px; line-height:1.4; }
  .course-card p { font-size:13px; color:var(--text2); line-height:1.5; margin-bottom:16px; }
  .progress-bar-wrap { margin-bottom:14px; }
  .progress-bar-label { display:flex; justify-content:space-between; font-size:12px; color:var(--text3); margin-bottom:6px; }
  .progress-bar { height:5px; background:var(--surface2); border-radius:10px; overflow:hidden; }
  .progress-fill { height:100%; background:linear-gradient(90deg,var(--accent),var(--accent3)); border-radius:10px; transition:width .5s; }
  .btn-course { width:100%; padding:10px; border-radius:var(--radius-sm); font-size:13px; font-weight:600; cursor:pointer; border:none; background:linear-gradient(135deg,var(--accent),#8B5CF6); color:#fff; }
  .btn-course:hover { opacity:.9; }

  /* COURSE DETAIL */
  #courseDetail { padding-top:64px; }
  .course-detail-header { background:linear-gradient(135deg,rgba(108,99,255,.2),rgba(56,189,248,.1)); border-bottom:1px solid var(--border); padding:40px 32px; }
  .course-detail-inner { max-width:900px; margin:0 auto; }
  .back-btn { display:flex; align-items:center; gap:8px; color:var(--text2); cursor:pointer; font-size:14px; margin-bottom:20px; background:none; border:none; }
  .back-btn:hover { color:var(--text); }
  .course-detail-header h1 { font-family:'Manrope',sans-serif; font-size:clamp(24px,4vw,36px); font-weight:800; margin-bottom:12px; }
  .course-detail-header p { color:var(--text2); font-size:16px; line-height:1.6; margin-bottom:20px; }
  .course-info-pills { display:flex; gap:12px; flex-wrap:wrap; }
  .info-pill { background:rgba(255,255,255,.06); border:1px solid var(--border); border-radius:100px; padding:6px 14px; font-size:13px; color:var(--text2); }
  .course-detail-body { max-width:900px; margin:0 auto; padding:32px; display:grid; grid-template-columns:1fr 320px; gap:32px; }
  @media(max-width:700px){ .course-detail-body{ grid-template-columns:1fr; } }
  .lessons-list { display:flex; flex-direction:column; gap:10px; }
  .lesson-item { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-sm); padding:16px 18px; display:flex; align-items:center; gap:14px; cursor:pointer; transition:all .2s; }
  .lesson-item:hover { border-color:var(--accent); }
  .lesson-item.completed { border-color:rgba(52,211,153,.4); }
  .lesson-num { width:32px; height:32px; border-radius:50%; background:var(--surface2); border:2px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; color:var(--text2); flex-shrink:0; }
  .lesson-item.completed .lesson-num { background:rgba(52,211,153,.2); border-color:var(--green); color:var(--green); }
  .lesson-info h4 { font-size:14px; font-weight:600; margin-bottom:2px; }
  .lesson-info span { font-size:12px; color:var(--text3); }
  .course-sidebar { }
  .sidebar-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:24px; margin-bottom:16px; }
  .sidebar-card h4 { font-size:15px; font-weight:700; margin-bottom:16px; }
  .quiz-option { background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius-sm); padding:12px 14px; margin-bottom:8px; cursor:pointer; font-size:14px; transition:all .2s; }
  .quiz-option:hover { border-color:var(--accent); color:var(--accent); }
  .quiz-option.correct { border-color:var(--green); background:rgba(52,211,153,.1); color:var(--green); }
  .quiz-option.wrong { border-color:#F87171; background:rgba(248,113,113,.1); color:#F87171; }
  .quiz-submit { width:100%; margin-top:8px; }

  /* DASHBOARD */
  .dashboard-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px; margin-bottom:32px; }
  .dash-stat { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); padding:22px; }
  .dash-stat-num { font-family:'Manrope',sans-serif; font-size:28px; font-weight:800; margin-bottom:4px; }
  .dash-stat-label { font-size:13px; color:var(--text2); }
  .dash-section { margin-bottom:32px; }
  .dash-section h3 { font-size:17px; font-weight:700; margin-bottom:16px; display:flex; align-items:center; gap:8px; }
  .deadlines-list { display:flex; flex-direction:column; gap:10px; }
  .deadline-item { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px 18px; display:flex; align-items:center; justify-content:space-between; }
  .deadline-info h4 { font-size:14px; font-weight:600; margin-bottom:2px; }
  .deadline-info span { font-size:12px; color:var(--text3); }
  .deadline-days { font-size:13px; font-weight:700; }
  .days-urgent { color:#F87171; }
  .days-soon { color:var(--orange); }
  .days-ok { color:var(--green); }

  /* ADMIN */
  .admin-tabs { display:flex; gap:4px; margin-bottom:24px; background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-sm); padding:4px; width:fit-content; }
  .admin-tab { padding:8px 18px; border-radius:6px; font-size:13px; font-weight:600; cursor:pointer; color:var(--text2); border:none; background:none; transition:all .2s; }
  .admin-tab.active { background:var(--accent); color:#fff; }
  .admin-panel { display:none; }
  .admin-panel.active { display:block; }
  .form-group { margin-bottom:16px; }
  .form-label { display:block; font-size:13px; font-weight:600; color:var(--text2); margin-bottom:6px; }
  .form-input { width:100%; background:var(--surface); border:1px solid var(--border); color:var(--text); padding:10px 14px; border-radius:var(--radius-sm); font-size:14px; outline:none; font-family:'Inter',sans-serif; }
  .form-input:focus { border-color:var(--accent); }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .admin-table { width:100%; border-collapse:collapse; }
  .admin-table th { text-align:left; padding:10px 14px; font-size:12px; font-weight:600; color:var(--text3); border-bottom:1px solid var(--border); }
  .admin-table td { padding:12px 14px; font-size:14px; border-bottom:1px solid var(--border); }
  .admin-table tr:hover td { background:rgba(255,255,255,.02); }
  .tag-del { background:rgba(248,113,113,.15); color:#F87171; border:none; padding:4px 10px; border-radius:100px; font-size:12px; cursor:pointer; }
  .tag-edit { background:rgba(108,99,255,.15); color:var(--accent); border:none; padding:4px 10px; border-radius:100px; font-size:12px; cursor:pointer; margin-right:4px; }
  .users-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:14px; }
  .user-card { background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-sm); padding:16px; }
  .user-card-top { display:flex; align-items:center; gap:10px; margin-bottom:10px; }
  .user-av { width:36px; height:36px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:14px; }
  .user-card h4 { font-size:14px; font-weight:700; }
  .user-card span { font-size:12px; color:var(--text3); }
  .user-stat { font-size:12px; color:var(--text2); display:flex; justify-content:space-between; margin-top:6px; }

  /* ONBOARDING MODAL */
  .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:200; display:flex; align-items:center; justify-content:center; padding:24px; backdrop-filter:blur(4px); }
  .modal-box { background:var(--surface); border:1px solid var(--border); border-radius:20px; padding:36px; max-width:520px; width:100%; }
  .modal-box h2 { font-family:'Manrope',sans-serif; font-size:24px; font-weight:800; margin-bottom:8px; }
  .modal-box p { color:var(--text2); font-size:15px; margin-bottom:28px; }
  .interest-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:24px; }
  .interest-btn { background:var(--surface2); border:1px solid var(--border); color:var(--text2); padding:10px; border-radius:var(--radius-sm); font-size:13px; cursor:pointer; text-align:center; transition:all .2s; }
  .interest-btn.selected { background:rgba(108,99,255,.2); border-color:var(--accent); color:var(--accent); }
  .modal-step { display:none; }
  .modal-step.active { display:block; }
  .step-dots { display:flex; gap:6px; margin-bottom:24px; }
  .step-dot { width:8px; height:8px; border-radius:50%; background:var(--border); }
  .step-dot.active { background:var(--accent); }

  /* TOAST */
  .toast { position:fixed; bottom:24px; right:24px; background:var(--surface2); border:1px solid var(--border); border-radius:var(--radius-sm); padding:14px 20px; font-size:14px; z-index:300; display:flex; align-items:center; gap:10px; transform:translateY(100px); opacity:0; transition:all .3s; max-width:340px; }
  .toast.show { transform:translateY(0); opacity:1; }
  .toast-icon { font-size:18px; }

  /* NOTIFICATION BADGE */
  .notif-badge { background:var(--accent); color:#fff; border-radius:50%; width:18px; height:18px; font-size:10px; display:flex; align-items:center; justify-content:center; font-weight:700; margin-left:-6px; margin-top:-6px; }

  /* EMPTY STATE */
  .empty-state { text-align:center; padding:60px 20px; }
  .empty-icon { font-size:48px; margin-bottom:16px; }
  .empty-state h3 { font-size:18px; font-weight:700; margin-bottom:8px; }
  .empty-state p { color:var(--text2); font-size:14px; }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width:6px; }
  ::-webkit-scrollbar-track { background:var(--bg); }
  ::-webkit-scrollbar-thumb { background:var(--border); border-radius:3px; }

  /* RESPONSIVE */
  @media(max-width:600px){
    nav { padding:0 16px; }
    .nav-links { display:none; }
    .content-area, .page-header { padding-left:16px; padding-right:16px; }
    .form-row { grid-template-columns:1fr; }
    .interest-grid { grid-template-columns:repeat(2,1fr); }
    .hero-cta { flex-direction:column; align-items:center; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="logo" onclick="showPage('home')">
    <div class="logo-icon">M</div>
    Mentoria Hub
  </div>
  <div class="nav-links">
    <button class="nav-link active" onclick="showPage('home');setActive(this)">Главная</button>
    <button class="nav-link" onclick="showPage('opportunities');setActive(this)">Возможности</button>
    <button class="nav-link" onclick="showPage('courses');setActive(this)">Курсы</button>
    <button class="nav-link" onclick="showPage('dashboard');setActive(this)">Кабинет</button>
    <button class="nav-link" onclick="showPage('admin');setActive(this)">Админ</button>
  </div>
  <div class="nav-right" id="navRight">
    <button class="btn btn-ghost btn-sm" onclick="showOnboarding()">Войти</button>
    <button class="btn btn-primary btn-sm" onclick="showOnboarding()">Регистрация</button>
  </div>
</nav>

<!-- TOAST -->
<div class="toast" id="toast"><span class="toast-icon">✅</span><span id="toastMsg">Сохранено!</span></div>

<!-- ========== HOME ========== -->
<div class="page active" id="page-home">
  <div class="hero">
    <div class="hero-badge">🚀 Образовательная платформа нового поколения</div>
    <h1>Все возможности<br>для твоего <span>роста</span> — здесь</h1>
    <p>Mentoria Hub помогает ученикам 8–11 классов находить конкурсы, стипендии, олимпиады и проходить курсы в удобное время — без привязки к расписанию.</p>
    <div class="hero-cta">
      <button class="btn btn-primary btn-large" onclick="showOnboarding()">Начать обучение →</button>
      <button class="btn btn-ghost btn-large" onclick="showPage('opportunities');setActiveByName('Возможности')">Найти возможности</button>
    </div>
    <div class="stats-row">
      <div class="stat"><div class="stat-num">120+</div><div class="stat-label">Возможностей</div></div>
      <div class="stat"><div class="stat-num">18</div><div class="stat-label">Курсов</div></div>
